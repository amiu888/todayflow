# Copy to deploy.env (never committed) and fill in for your NAS.
# Used by deploy.sh on the Mac and by truenas-install.py on the NAS.

# SSH login for the NAS (an admin user that can run midclt).
NAS_SSH=admin@nas.local

# Dataset folder for TodayFlow. Holds app/, postgres/, blobs/ and control/.
TODAYFLOW_BASE=/mnt/tank/todayflow

# Where daily database dumps go; another disk or pool is best.
TODAYFLOW_BACKUPS=/mnt/backup/todayflow-backups

# The sync address the Macs use (shown after deploy).
TODAYFLOW_URL=http://nas.local:8787

# Optional: the address devices use from anywhere (Tailscale or a Cloudflare
# Tunnel). The admin page shows it next to pairing codes. Defaults to TODAYFLOW_URL.
TODAYFLOW_PUBLIC_URL=https://todayflow.example.com
