POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Password for the admin page on port 8788. At least 12 characters.
# (Each user's pairing code is created on that page.)
TODAYFLOW_ADMIN_PASSWORD=change-me-to-a-long-random-string
# Where the database files live (a TrueNAS dataset path, for example).
DATA_DIR=./data
PORT=8787
