# Copy to signing.env (ignored) and fill in.
# Your Apple team id: Xcode ▸ Settings ▸ Accounts, or developer.apple.com ▸ Membership.
DEVELOPMENT_TEAM=

# Optional: server address pre-filled in Settings ▸ Sync (your own server only;
# leave empty for builds you give to other people).
TODAYFLOW_DEFAULT_SERVER=
# Optional, for scripts/testflight.sh when the Mac is locked: an App Store
# Connect API key (Users and Access ▸ Integrations ▸ App Store Connect API,
# role App Manager). Save the .p8 as ~/.appstoreconnect/private_keys/AuthKey_<id>.p8
ASC_KEY_ID=
ASC_ISSUER_ID=
